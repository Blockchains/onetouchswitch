{
  "$schema": "https://raw.githubusercontent.com/Blockchains/.github/main/docs/blocks.schema.json",
  "schema_version": "1.0",
  "name": "onetouchswitch",
  "repo": "Blockchains/onetouchswitch",
  "summary": "Local-first, self-hostable UK broadband comparison core for onetouchswitch.com: OS Code-Point Open postcodes, manual address, reviewed versioned offer catalogue, deterministic dinero.js cost engine, caveats, provider links, session records, Stage-2 Docling bill queue. Static Pages build + ESM engine.",
  "kind": ["web-app", "http-api", "library", "dataset"],
  "stability": "beta",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://blockchains.github.io/onetouchswitch/",
  "entrypoints": [
    { "type": "web", "name": "static comparison app", "ref": "https://blockchains.github.io/onetouchswitch/" },
    { "type": "http", "name": "GET /api/v1/postcode/{OUTWARD}.json", "ref": "https://blockchains.github.io/onetouchswitch/api/v1/postcode/HU1.json", "usage": "rows [postcode, country_code, district_code, ward_code] + names" },
    { "type": "http", "name": "GET /api/v1/index.json", "ref": "https://blockchains.github.io/onetouchswitch/api/v1/index.json" },
    { "type": "browser-script", "name": "ots-engine.mjs", "ref": "https://blockchains.github.io/onetouchswitch/engine/v1/ots-engine.mjs", "usage": "const { OTSStatic } = await import(url)", "exports": ["OTSStatic", "OFFER_COPY", "normalisePostcode", "caveatsFor"] },
    { "type": "docker", "name": "self-hosted server", "ref": "docker-compose.yml", "usage": "npm run stage && docker compose up app" },
    { "type": "cli", "name": "review", "ref": "scripts/review.mjs", "usage": "npm run review -- list|add|approve|reject|publish" }
  ],
  "inputs": [
    { "name": "postcode", "type": "string" },
    { "name": "manual address", "type": "object" },
    { "name": "current deal + quotes", "type": "object" },
    { "name": "bill PDF/image (Stage 2)", "type": "file" }
  ],
  "outputs": [
    { "name": "location + caveats", "type": "json" },
    { "name": "ranked contract-cost comparison", "type": "json" },
    { "name": "session record", "type": "json" }
  ],
  "deps": ["node>=22", "unzip (staging)", "optional: redis, docling-serve, postcodes.io, libpostal"],
  "compatible_with": [
    { "repo": "Blockchains/onetouchswitch-bridge", "how": "B2B partner-payout data (GBP/USD, stablecoin rails) for /for-partners; separate from consumer comparison" },
    { "repo": "Blockchains/onetouchswitch.com", "how": "backup mirror of the live site" },
    { "repo": "Blockchains/sites-monitor", "how": "uptime/SEO monitoring of onetouchswitch.com" }
  ],
  "tests": { "command": "npm test && npx playwright test", "ci": ".github/workflows/ci.yml", "network": false },
  "docs": { "readme": "README.md", "agents": "AGENTS.md", "llms": "llms.txt", "extra": ["docs/INTEGRATION.md", "docs/STAGES.md", "docs/ARCHITECTURE.md"] },
  "tags": ["onetouchswitch", "broadband", "uk", "comparison", "postcodes", "code-point-open", "dinero", "tanstack", "bullmq", "docling", "playwright", "local-first"]
}
